{
  "manifest_version": 3,
  "name": "Hangar-Exporter",
  "version": "0.5.0",
  "key": "",
  "description": "Liest deinen Hangar bei RSI. Speichert ihn als Datei oder sendet ihn nur auf Knopfdruck an VerseKit oder das Basetool.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://ingest.profit-base.online/*"
  ],
  "background": {
    "service_worker": "hintergrund/hintergrund.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://robertsspaceindustries.com/account/pledges*",
        "https://robertsspaceindustries.com/*/account/pledges*"
      ],
      "js": [
        "src/baum.js",
        "src/seite.js",
        "src/buyback.js",
        "src/schiffswerte.js",
        "src/schiffsliste.js",
        "src/uebergabe.js",
        "src/schiffsexport.js",
        "src/basetoolliste.js",
        "src/hangarlink.js",
        "src/sammler.js",
        "src/inhalt.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
